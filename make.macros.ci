#~ -----------------------------------------------------------------------------
#~   make.macros.ci -- standalone build configuration for FROG
#~
#~   Unlike the regular make.macros (generated by LIPaS from
#~   make_macros.LIPaS), this file has NO external dependency: it is meant
#~   to be usable by anyone with a Fortran compiler, netCDF-Fortran and
#~   LAPACK installed through their system package manager.
#~
#~   Intended users:
#~     - continuous integration runners
#~     - anyone wanting to build FROG without installing the LIPaS toolchain
#~
#~   Usage:
#~     cp make.macros.ci make.macros
#~     make MODE=production        # optimised, sequential (default)
#~     make MODE=openmp            # optimised + OpenMP  (offline runs only)
#~     make MODE=debug             # bounds checking, warnings, no optimisation
#~
#~   The Makefile expects this file to provide exactly four variables:
#~     FC, FFLAGS, INCLUDES, LIBS
#~   plus an `include` of a compiler options file defining F_FLAGS_EXTD.
#~ -----------------------------------------------------------------------------


#~ -----------------------------------------------------------------------------
#~ 1. COMPILER SELECTION
#~ -----------------------------------------------------------------------------
#~ FROG is maintained to build with gfortran, Intel and NVIDIA HPC compilers.
#~ Override on the command line, e.g.  make COMPILER=intel

COMPILER ?= gnu

ifeq ($(COMPILER),gnu)
  FC = gfortran
  include gfortran.options
else ifeq ($(COMPILER),intel)
  #~ ifort classic (deprecated since 2024, superseded by ifx)
  FC = ifort
  include ifort19.options
else ifeq ($(COMPILER),intel-llvm)
  #~ ifx -- LLVM-based Intel compiler. Flag syntax is close to ifort19 but
  #~ NOT identical; a dedicated ifx.options file should be created when this
  #~ toolchain becomes the primary Intel target.
  FC = ifx
  include ifort19.options
else ifeq ($(COMPILER),nvidia)
  FC = nvfortran
  include nvfortran.options
else
  $(error Unknown COMPILER=$(COMPILER). Use one of: gnu, intel, intel-llvm, nvidia)
endif


#~ -----------------------------------------------------------------------------
#~ 2. BUILD MODE
#~ -----------------------------------------------------------------------------
#~ [IMPORTANT] Do NOT set FFLAGS twice with `=`: in make, the second
#~ assignment silently overrides the first, which makes it impossible to tell
#~ from reading the file which flags are actually in effect. Use MODE instead.
#~
#~   production : -O3, sequential. This is the reference configuration.
#~   openmp     : -O3 + OpenMP. Offline runs ONLY -- see the note in section 4.
#~   debug      : full runtime checking. Expect a 5x-20x slowdown; never use
#~                this mode for production runs or for timing measurements.

MODE ?= production

ifeq ($(MODE),production)
  FFLAGS   = $(F_OPTIM_HIGH) $(F_PRE_PROCESS)
  OMP_LIBS =
else ifeq ($(MODE),openmp)
  FFLAGS   = $(F_OPTIM_HIGH) $(F_PRE_PROCESS) $(F_OPENMP)
  OMP_LIBS = $(F_OPENMP_LIB)
else ifeq ($(MODE),debug)
  FFLAGS   = $(DBG_FLAGS) $(F_PRE_PROCESS)
  OMP_LIBS =
else
  $(error Unknown MODE=$(MODE). Use one of: production, openmp, debug)
endif


#~ -----------------------------------------------------------------------------
#~ 3. EXTERNAL LIBRARIES
#~ -----------------------------------------------------------------------------
#~ Debian/Ubuntu packages required:
#~     libnetcdff-dev    Fortran bindings -- provides netcdf.mod
#~     libnetcdf-dev     C library        -- pulled in as a dependency of the
#~                                           above, but listed explicitly since
#~                                           installing only libnetcdf-dev is a
#~                                           common mistake (no netcdf.mod).
#~     liblapack-dev     LAPACK           -- FROG calls sgtsv (single precision)
#~
#~   sudo apt-get install gfortran libnetcdff-dev libnetcdf-dev liblapack-dev
#~
#~ On systems providing nf-config (most distributions do), the two lines below
#~ resolve paths automatically. On clusters where modules are loaded by hand,
#~ replace them with the explicit -I/-L paths for your site.

NETCDF_INC := $(shell nf-config --fflags 2>/dev/null)
NETCDF_LIB := $(shell nf-config --flibs  2>/dev/null)

#~ Fallback if nf-config is unavailable (typical Debian/Ubuntu layout)
ifeq ($(strip $(NETCDF_INC)),)
  NETCDF_INC = -I/usr/include
endif
ifeq ($(strip $(NETCDF_LIB)),)
  NETCDF_LIB = -lnetcdff -lnetcdf
endif

LAPACK_LIB = -llapack

INCLUDES = $(NETCDF_INC)
LIBS     = $(NETCDF_LIB) $(LAPACK_LIB) $(OMP_LIBS)


#~ -----------------------------------------------------------------------------
#~ 4. NOTE ON OpenMP
#~ -----------------------------------------------------------------------------
#~ The spatial loop in DO_spatialvars_step carries !$omp directives. As of
#~ commit 2bd9ddb they are validated for OFFLINE, CARBON=0 runs only:
#~
#~   - with CARBON=1, `deepSOM_tot_yr` is accumulated inside the parallel
#~     region without a reduction clause, and Carbon.f90 writes to the module
#~     variables f_a / f_s / f_p from within carbon_redistribute. Both are
#~     data races.
#~   - `add_layer` in simple_snow.f90 has an implicit SAVE attribute and is
#~     therefore shared across threads.
#~
#~ Additionally, a FROG library built with OpenMP does not currently link
#~ against iLOVECLIM. When investigating this, check first that -fopenmp is
#~ present on the FINAL link line of the coupled executable and not only when
#~ building libfrog.a: with gfortran the OpenMP runtime must be initialised
#~ once for the whole program.
#~
#~ Default is therefore MODE=production (sequential) so that an uninformed
#~ user gets correct results without having to know any of the above.
#~ -----------------------------------------------------------------------------


#~ The End of All Things (op. cit.)
