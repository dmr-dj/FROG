# Generic definitions ...

F_OPTIM_HIGH  = -O2
F_PRE_PROCESS = -cpp
F_FLAGS_EXTD  = -132
F_FLAGS_CARD  = -80
F_DFLT_DBLE8  = 
F_DFLT_REAL8  = -r8
F_DFLT_DBLE   = $(F_DFLT_REAL8) $(F_DFLT_DBLE8)
F_DFLT_INTG8  = -i8
F_DFLT_INTG4  = -i4
F_INIT_ZERO   = -zero
F_STRCT_EIGHT = -stand f08 -free
F_TREAT_FORTR = -Tf
F_IMPLIC_NONE = -u
# By default intel fortran compilers do not care about the sign of zero.
# To have a zero signed, use -assume minus0
F_SIGN_ZERO   = -assume nominus0
F_REC_MARK    = -assume byterecl
# ???
F_HEAD_FIL    = -I
F_MAX_ERR     =
DIAG_DISABLE  = -diag-disable warn

F_BIG_ENDIAN  = -convert big_endian
# Could be deprecated if no commons left ...
F_NO_ALIGN    = -noalign
F_MEM_MODEL_M = -mcmodel=medium
F_MEM_MODEL_L = -mcmodel=large
F_LARGE_ARRAY =
# TO BE DONE MORE EXTENSIVELY !!!
DBG_FLAGS     = -traceback -C -warn all -fpe0
# can be used for alternate DBG_FLAGS line

CMP_SPECF     = -fp-model precise -gen-interface -vec_report0 -diag-disable 10246 -diag-disable 10212
OPENMP        = -openmp -openmp-link static -auto-scalar -norecursive

# ---------------------------------------------------------------------------
# NOTE: this file must contain COMPILER FLAGS ONLY, not library/include paths.
#
# It used to also carry a block of iLOVECLIM library definitions (INCNETCDF,
# LIBNETCDF, INCNCIO, LIBUDUNITS, ... INC_F_DIR, MOD_F_DIR), each built from a
# ${..._path} variable that only exists inside the iLOVECLIM environment. In a
# standalone FROG build those paths are empty, so e.g. "INCNETCDF = -I${inc_netcdf_path}"
# expanded to a bare "-I". Worse, because a local make.macros includes this
# file AFTER FROG.libinc, that bare "-I" OVERWROTE the correct INCNETCDF from
# FROG.libinc. The dangling "-I" then swallowed the following "-c" in the
# object rule (ifort read "-I -c" as "add directory named -c to the include
# path"), dropped compile-only mode, tried to link, and failed with
# "undefined reference to MAIN__". gfortran was unaffected only because its
# options file never redefined these variables.
#
# Include/library paths belong in FROG.libinc / make.macros (standalone) or in
# the iLOVECLIM build system (coupled), never here. Block removed.
# ---------------------------------------------------------------------------

# The End of All Things (op. cit.)
